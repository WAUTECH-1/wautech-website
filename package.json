{
  "name": "wautech-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5188",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings=0",
    "test": "node --test scripts/site.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "@react-three/fiber": "^9.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "globals": "^16.4.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.2"
  }
}
